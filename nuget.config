	</packageSources>
	<packageSourceMapping>
		<packageSource key="a11y-insights-windows">
			<package pattern="*" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="WixToolset.*" />
			<package pattern="Microsoft.VisualStudioEng.MicroBuild.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>